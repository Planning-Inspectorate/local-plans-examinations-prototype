<style>
  .app-header {
    margin-bottom: 20px;
  }

  .app-header__title {
    margin-bottom: 5px;
  }

  .app-header__tag {
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .app-details .govuk-summary-list__key,
  .app-details .govuk-summary-list__value {
    padding-top: 6px;
    padding-bottom: 6px;
  }
</style>

<div class="app-header">
  <h1 class="govuk-heading-xl app-header__title">
    <span class="govuk-caption-xl">East Borough local plan</span>
    Gateway 2 submission
  </h1>
  {% if currentStage == 'gateway-2' and reportStatus != 'shared' %}
    <strong class="govuk-tag govuk-tag--yellow app-header__tag">
      Under review
    </strong>
  {% else %}
    <strong class="govuk-tag app-header__tag">
      Completed
    </strong>
  {% endif %}
</div>

  {% set reportStatus = data['report'] %}

  {% set workshopDocuments %}
    <ul class="govuk-list">
      <li><a class="govuk-link" href="#">workshop-agenda.pdf</a> (shared: 8 Aug 2026)</li>
      <li><a class="govuk-link" href="#">workshop-questions.pdf</a> (shared: 8 Aug 2026)</li>
    </ul>
  {% endset %}

  {% set gw2ReportDocument %}
    <a class="govuk-link" href="#">gateway-2-report.pdf</a> (shared on 8 May 2026)
  {% endset %}

  {% if reportStatus == 'shared' %}
    {{ govukSummaryList({
      classes: "app-details govuk-summary-list--no-border",
      rows: [
        {
          key: { text: "Gateway 2 report", classes: "govuk-!-width-one-third" },
          value: { html: gw2ReportDocument }
        }
      ]
    }) }}
  {% endif %}

  <h2 class="govuk-heading-m">
    Workshop
  </h2>

{% set summaryRows = [
  {
    key: { text: "Format", classes: "govuk-!-width-one-third" },
    value: { text: "In-person" }
  },
  {
    key: { text: "Venue", classes: "govuk-!-width-one-third" },
    value: { html: "East Borough Civic Centre<br>14 Market Street<br>East Borough<br>EB1 4QT" }
  },
  {
    key: { text: "Start time", classes: "govuk-!-width-one-third" },
    value: { text: "10am, 12 May 2026" }
  },
  {
    key: { text: "Documents", classes: "govuk-!-width-one-third" },
    value: { html: workshopDocuments }
  }
] %}

{{ govukSummaryList({
  classes: "app-details govuk-summary-list--no-border",
  rows: summaryRows
}) }}

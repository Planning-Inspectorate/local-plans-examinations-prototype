<style>
  .app-header {
    margin-bottom: 20px;
  }

  .app-header__title {
    margin-bottom: 5px;
  }

  .app-header__tag {
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .app-details .govuk-summary-list__key,
  .app-details .govuk-summary-list__value {
    padding-top: 6px;
    padding-bottom: 6px;
  }
</style>

{% set currentStage = data['stage'] or 'gateway-2' %}

<div class="app-header">
  <h1 class="govuk-heading-xl app-header__title">
    <span class="govuk-caption-xl">East Borough local plan</span>
    Gateway 2 submission
  </h1>
  {% if currentStage == 'gateway-2' %}
    <strong class="govuk-tag govuk-tag--yellow app-header__tag">
      Under review
    </strong>
  {% else %}
    <strong class="govuk-tag app-header__tag">
      Completed
    </strong>
  {% endif %}
</div>

  {% set reportStatus = data['report'] %}

  {% set workshopDocuments %}
    <ul class="govuk-list">
      <li><a class="govuk-link" href="#">workshop-agenda.pdf</a> (shared on 8 May 2026)</li>
      <li><a class="govuk-link" href="#">workshop-questions.pdf</a> (shared on 8 May 2026)</li>
    </ul>
  {% endset %}

  {% set gw2ReportDocument %}
    <a class="govuk-link" href="#">gateway-2-report.pdf</a> (shared on 8 May 2026)
  {% endset %}

{% set summaryRows = [
  {
    key: { text: "Workshop venue", classes: "govuk-!-width-one-third" },
    value: { text: "East Borough Civic Centre" }
  },
  {
    key: { text: "Workshop date and time", classes: "govuk-!-width-one-third" },
    value: { text: "19 May 2026 at 10am" }
  },
  {
    key: { text: "Workshop documents", classes: "govuk-!-width-one-third" },
    value: { html: workshopDocuments }
  }
] %}

{% if reportStatus == 'shared' %}
  {% set summaryRows = summaryRows.concat([{
    key: { text: "Gateway 2 report", classes: "govuk-!-width-one-third" },
    value: { html: gw2ReportDocument }
  }]) %}
{% endif %}

{{ govukSummaryList({
  classes: "app-details govuk-summary-list--no-border",
  rows: summaryRows
}) }}

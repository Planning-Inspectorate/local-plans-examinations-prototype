<style>
  .app-header {
    margin-bottom: 20px;
  }

  .app-header__title {
    margin-bottom: 5px;
  }

  .app-header__tag {
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .app-details .govuk-summary-list__key,
  .app-details .govuk-summary-list__value {
    padding-top: 6px;
    padding-bottom: 6px;
  }
</style>

    {% if submission == '1' %}
      {% set reportLabel = "Submission 1 report" %}
      {% set reportHtml = "<a class='govuk-link' href='#'>View report</a> (issued 27 Jun 2026)" %}
    {% else %}
      {% set reportLabel = "Submission 2 report" %}
      {% set reportHtml = "<a class='govuk-link' href='#'>View report</a> (issued 13 Jul 2026)" %}
    {% endif %}

    {% if showSubmissionHistory %}
      {% set reportRow = {
        key: { text: reportLabel, classes: "govuk-!-width-one-third" },
        value: { html: reportHtml }
      } %}
      {% set submission1Row = {
        key: { text: "Submission 1", classes: "govuk-!-width-one-third" },
        value: { html: "<a class='govuk-link' href='application-details-decision?newDocuments=" + ("true" if submission == '2' else "false") + "&viewOnly=true&submission=1'>View all documents</a> (submitted 20 Jun 2026)" }
      } %}
      {% set submission2Row = {
        key: { text: "Submission 2", classes: "govuk-!-width-one-third" },
        value: { html: "<a class='govuk-link' href='application-details-decision?newDocuments=true&viewOnly=true&submission=2'>View all documents</a> (submitted 1 Jul 2026)" }
      } %}
      {% if submission == '2' %}
        {% set decisionMetadataRows = [reportRow, submission1Row] %}
      {% elif submission == '1' %}
        {% set decisionMetadataRows = [reportRow, submission2Row] %}
      {% else %}
        {% set decisionMetadataRows = [reportRow, submission2Row, submission1Row] %}
      {% endif %}
    {% else %}
      {% set decisionMetadataRows = [
        {
          key: { text: reportLabel, classes: "govuk-!-width-one-third" },
          value: { html: reportHtml }
        }
      ] %}
    {% endif %}

    {{ govukSummaryList({
      classes: "app-details govuk-summary-list--no-border",
      rows: decisionMetadataRows
    }) }}





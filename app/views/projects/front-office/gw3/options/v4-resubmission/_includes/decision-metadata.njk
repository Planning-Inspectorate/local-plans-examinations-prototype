<style>
  .app-header {
    margin-bottom: 20px;
  }

  .app-header__title {
    margin-bottom: 5px;
  }

  .app-header__tag {
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .app-details .govuk-summary-list__key,
  .app-details .govuk-summary-list__value {
    padding-top: 6px;
    padding-bottom: 6px;
  }
</style>

    {% set decisionMetadataRows = [
      {
        key: { text: "Gateway 3 report", classes: "govuk-!-width-one-third" },
        value: { html: "<a class='govuk-link' href='#'>gateway-3-report.pdf</a> (shared on 3 July 2026)" }
      }
    ] %}

    {% if showSubmissionHistory %}
      {% set decisionMetadataRows = decisionMetadataRows.concat([
        {
          key: { text: "Submission history", classes: "govuk-!-width-one-third" },
          value: { html: "<a class='govuk-link' href='application-details-resubmitted'>View submission history</a>" }
        }
      ]) %}
    {% endif %}

    {{ govukSummaryList({
      classes: "app-details govuk-summary-list--no-border",
      rows: decisionMetadataRows
    }) }}





<style>
  .app-header {
    margin-bottom: 20px;
  }

  .app-header__title {
    margin-bottom: 5px;
  }

  .app-header__tag {
    margin-top: 15px;
    margin-bottom: 15px;
  }

  .app-details .govuk-summary-list__key,
  .app-details .govuk-summary-list__value {
    padding-top: 6px;
    padding-bottom: 6px;
  }
</style>

<div class="app-header">
  <h1 class="govuk-heading-xl app-header__title">
    <span class="govuk-caption-xl">East Borough Local Plan</span>
    Gateway 3 submission
  </h1>
  {% if requiredCompletedCount > 0 or aboutYourPlanCompletedCount > 0 %}
    <strong class="govuk-tag govuk-tag--blue app-header__tag">
      In progress
    </strong>
  {% else %}
    <strong class="govuk-tag govuk-tag--green app-header__tag">
      Ready to start
    </strong>
  {% endif %}
</div>

{% call govukInsetText() %}
Your target submission date is 25 April 2026. A Gateway 3 assessment usually takes about 6 weeks.
{% endcall %}
